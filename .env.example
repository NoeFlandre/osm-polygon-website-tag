# Example environment file. Copy to .env and fill in real values.
# .env is git-ignored; never commit credentials.

# Generated-data root: runs, model caches, Grid'5000 bundles (default: ./data)
OSM_POLY_DATA_DIR=

# Hugging Face dataset that receives pushed artifacts
HF_DATASET_REPO=NoeFlandre/osm-polygon-website-tag

# Hugging Face write token for publishing (HUGGING_FACE_HUB_TOKEN also works).
# HF_TOKEN=
