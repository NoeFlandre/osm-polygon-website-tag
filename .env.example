# Example environment file. Copy to .env and fill in real values.
# .env is git-ignored; never commit credentials.

# Override the default local data root (default: /Volumes/Seagate M3/projects/osm-polygon-website-tag)
OSM_POLY_DATA_DIR=

# Hugging Face dataset that receives pushed artifacts
HF_DATASET_REPO=NoeFlandre/osm-polygon-website-tag

# Hugging Face token (required only for private datasets or write access)
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=
